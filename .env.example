# ==============================================================================
# Atlas Production Template — Environment Configuration Template (V1.1)
# ==============================================================================
# Copy this file to .env on the production host:
#   cp .env.example .env && chmod 600 .env
# Never commit .env files containing real production credentials to Git.
# ==============================================================================

# Global Host Settings
ENVIRONMENT=production
ATLAS_HOSTNAME=vps.example.com
ADMIN_EMAIL=admin@example.com

# Global Backup Storage
ATLAS_BACKUP_STORAGE_DIR=/var/backups
ATLAS_BACKUP_RETENTION_DAYS=14

# Client-Side Asymmetric Encryption (age)
# Generate with: age-keygen
# The public recipient key goes on the VPS. The private identity key stays OFFLINE.
ATLAS_AGE_RECIPIENT=age1ql3z7hjykgpwpw33...

# Off-Site Cloud Replication (Cloudflare R2 / AWS S3)
ATLAS_OFFSITE_PROVIDER=auto
ATLAS_S3_BUCKET=atlas-production-backups
ATLAS_S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
ATLAS_S3_ACCESS_KEY=your_access_key_id_here
ATLAS_S3_SECRET_KEY=your_secret_access_key_here

# Failure & Alerting Notifications (Optional)
ATLAS_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
ATLAS_SLACK_WEBHOOK=https://hooks.slack.com/services/...
ATLAS_TELEGRAM_BOT_TOKEN=123456789:ABCdef...
ATLAS_TELEGRAM_CHAT_ID=-100123456789
ATLAS_GENERIC_WEBHOOK=https://monitoring.example.com/alerts

# PostgreSQL Global Template Defaults
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=generate_a_secure_32_character_password_here
POSTGRES_DB=app_production_db

# Redis Global Template Defaults
REDIS_PASSWORD=generate_a_secure_32_character_password_here

# LetsEncrypt Contact
CERTBOT_EMAIL=security@example.com
