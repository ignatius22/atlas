# ==============================================================================
# Atlas V1 — Environment Configuration Template
# ==============================================================================
# NEVER COMMIT .env TO VERSION CONTROL.
# ==============================================================================

# Asymmetric Age Encryption (X25519)
ATLAS_AGE_RECIPIENT="age1..."

# Off-Site Object Storage (Cloudflare R2 / AWS S3 / MinIO)
ATLAS_OFFSITE_PROVIDER="s3"
ATLAS_S3_BUCKET="example-backups"
ATLAS_S3_ENDPOINT="https://s3.example.com"
ATLAS_S3_REGION="us-east-1"
ATLAS_S3_ACCESS_KEY="EXAMPLEACCESSKEY"
ATLAS_S3_SECRET_KEY="EXAMPLESECRETKEY"

# Dashboard Binding
ATLAS_DASHBOARD_HOST="127.0.0.1"
ATLAS_DASHBOARD_PORT="8888"
