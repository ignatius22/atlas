[Unit]
Description=Atlas Daily Restore Drill (restore newest backups into throwaway containers and verify row counts)
Documentation=https://github.com/ignatius22/atlas
After=network-online.target docker.service atlas-backup.service
Wants=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/atlas
EnvironmentFile=-/opt/atlas/.env
# systemd expands $VAR itself, so the shell variable is written $$rc.
ExecStart=/bin/bash -c 'rc=0; /opt/atlas/scripts/drill.sh --all || rc=$$?; python3 /opt/atlas/scripts/lib/heartbeat.py send --event drill --exit-code $$rc; exit $$rc'
# Drills restore real databases; give large ones time.
TimeoutStartSec=2h
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal

ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
