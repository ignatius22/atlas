[Unit]
Description=Atlas Automated Database Backup and Off-Site Sync
Documentation=https://github.com/ignatius22/atlas
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/atlas
EnvironmentFile=-/opt/atlas/.env
# Sync runs even if one app's backup failed, so a single stopped container
# never blocks the other apps' backups from reaching offsite storage.
# Afterwards a status report goes to ATLAS_HEARTBEAT_URL (if set) so an external
# watchdog notices both failures and silence. systemd expands $VAR itself, so
# the shell variable is written $$rc.
ExecStart=/bin/bash -c 'rc=0; /opt/atlas/scripts/backup.sh --all || rc=1; /opt/atlas/scripts/sync-offsite.sh --all || rc=1; python3 /opt/atlas/scripts/lib/heartbeat.py send --event backup --exit-code $$rc; exit $$rc'
StandardOutput=journal
StandardError=journal

# Sensible hardening options compatible with Docker daemon socket access
# Ensures the service cannot alter kernel tuning or control groups while
# maintaining full compatibility with /var/run/docker.sock and docker exec.
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictSUIDSGID=false
