[Unit]
Description=Atlas Automated Database Backup and Off-Site Sync
Documentation=https://github.com/ignatius22/atlas
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/atlas
EnvironmentFile=-/opt/atlas/.env
ExecStart=/bin/bash -c '/opt/atlas/scripts/backup.sh --all && /opt/atlas/scripts/sync-offsite.sh --all'
StandardOutput=journal
StandardError=journal

# Sensible hardening options compatible with Docker daemon socket access
# Ensures the service cannot alter kernel tuning or control groups while
# maintaining full compatibility with /var/run/docker.sock and docker exec.
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictSUIDSGID=false
